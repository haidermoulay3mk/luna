{
  "name": "luna",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Luna: Junior Astronaut Mission Trainer. A 3D Moon-and-Mars exploration and decision game for players aged 7 to 12 (walk your astronaut, fly the rocket, climb Olympus Mons, play solo or in an online crew) (NASA Space Apps 2026, Team GWIN, Bahrain). The game concept, story and missions are by the team; the code was written with help from Claude (Anthropic), an AI assistant.",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "build:usb": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --config vite.usb.config.ts",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node node_modules/vitest/vitest.mjs run",
    "snapshot": "node scripts/snapshot.mjs",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "framer-motion": "^14.14.0",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@react-three/test-renderer": "^8.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "homepage": "https://luna-swart-phi.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/haidermoulay3mk/luna.git"
  }
}
